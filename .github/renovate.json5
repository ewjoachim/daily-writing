{
  extends: ["config:recommended", ":enablePreCommit", "helpers:pinGitHubActionDigests"],
  schedule: ["* * 6 * *"],
  labels: ["deps"],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^daily_writing/settings\\.py$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\] = \"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
  packageRules: [
    {
      groupName: "all dependencies",
      groupSlug: "all",
      matchPackageNames: ["*"],
    },
  ],
  automerge: true,
}
